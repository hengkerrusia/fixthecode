import json
import secrets
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs

USERS = {
    "admin": {"password": "admin-pw", "full_name": "Platform Administrator"},
}

SESSIONS = {}

PLUGINS = {
    "PayPerView": {"paypalReceiverEmail": "payments@myvideosite.com",
                   "stripeKey": "sk_live_9f2kLq7x"},
    "AWS_S3": {"bucket": "myvideosite-media", "region": "us-east-1",
               "key": "AKIAIOSFODNN7EXAMPLE",
               "secret": "wJalrXUtnFEMI/K7MDENG/bPxRfiCY"},
    "LDAP": {"server": "ldap://directory.internal",
             "baseDN": "dc=internal,dc=local"},
}

PANEL = """<!doctype html>
<html><head><meta charset="utf-8"><title>Video Platform</title></head>
<body>
<h1>Admin Login</h1>
<form method="post" action="/login">
<input name="username" placeholder="username">
<input name="password" type="password" placeholder="password">
<button type="submit">Login</button>
</form>
</body></html>"""


def edit_form(name, cfg, csrf):
    rows = "".join(
        '<label>%s <input name="%s" value="%s"></label><br>' % (k, k, v)
        for k, v in cfg.items())
    return """<!doctype html>
<html><head><meta charset="utf-8"><title>Edit %s</title></head>
<body>
<h1>Plugin settings: %s</h1>
<form method="post" action="/admin/save.json.php">
<input type="hidden" name="csrf_token" value="%s">
<input type="hidden" name="pluginName" value="%s">
%s
<button type="submit">Save</button>
</form>
</body></html>""" % (name, name, csrf, name, rows)


class Handler(BaseHTTPRequestHandler):
    server_version = "Lab39/1.0"

    def _send(self, code, obj, cookie=None):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        if cookie:
            self.send_header("Set-Cookie",
                             "session=" + cookie + "; Path=/; SameSite=None")
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, code, html):
        body = html.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _form(self):
        try:
            n = int(self.headers.get("Content-Length", 0))
        except ValueError:
            n = 0
        raw = self.rfile.read(n) if n else b""
        return {k: v[0] for k, v in parse_qs(raw.decode()).items()}

    def _session(self):
        cookie = self.headers.get("Cookie", "")
        sid = ""
        for part in cookie.split(";"):
            part = part.strip()
            if part.startswith("session="):
                sid = part[len("session="):]
                break
        return SESSIONS.get(sid, (None, None))

    def log_message(self, *args):
        pass

    def do_GET(self):
        parts = urlparse(self.path)
        if parts.path == "/":
            self._send_html(200, PANEL)
            return
        user, csrf = self._session()
        if not user:
            self._send(401, {"error": "unauthorized"})
            return
        if parts.path == "/me":
            self._send(200, {"username": user,
                             "full_name": USERS[user]["full_name"]})
            return
        if parts.path == "/admin/plugins":
            self._send(200, {"plugins": PLUGINS})
            return
        if parts.path == "/admin/plugin/edit":
            name = parse_qs(parts.query).get("name", [""])[0]
            if name not in PLUGINS:
                self._send(404, {"error": "unknown plugin"})
                return
            self._send_html(200, edit_form(name, PLUGINS[name], csrf))
            return
        self._send(404, {"error": "not found"})

    def do_POST(self):
        parts = urlparse(self.path)
        if parts.path == "/login":
            form = self._form()
            username = form.get("username", "").strip().lower()
            u = USERS.get(username)
            if not u or u["password"] != form.get("password", ""):
                self._send(401, {"error": "invalid credentials"})
                return
            sid = "sess_" + secrets.token_hex(8)
            csrf = "csrf_" + secrets.token_hex(16)
            SESSIONS[sid] = (username, csrf)
            self._send(200, {"ok": True, "csrf_token": csrf}, cookie=sid)
            return
        if parts.path == "/admin/save.json.php":
            user, csrf = self._session()
            if not user:
                self._send(401, {"error": "unauthorized"})
                return
            form = self._form()
            if form.get("csrf_token", "") != csrf:
                self._send(403, {"error": "bad csrf token"})
                return
            name = form.get("pluginName", "")
            if name not in PLUGINS:
                self._send(404, {"error": "unknown plugin"})
                return
            for k, v in form.items():
                if k in ("pluginName", "csrf_token"):
                    continue
                PLUGINS[name][k] = v
            self._send(200, {"success": True})
            return
        self._send(404, {"error": "not found"})


if __name__ == "__main__":
    HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
