import json
import secrets
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs

USERS = {
    "admin": {"password": "admin-pw", "email": "admin@lab.test",
              "full_name": "Store Administrator", "is_admin": True},
}

SESSIONS = {}

PANEL = """<!doctype html>
<html><head><meta charset="utf-8"><title>POS Admin</title></head>
<body>
<h1>POS Admin Panel</h1>
<form method="post" action="/login">
<input name="username" placeholder="username">
<input name="password" type="password" placeholder="password">
<button type="submit">Login</button>
</form>
</body></html>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "Lab35/1.0"

    def _send(self, code, obj, cookie=None):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        if cookie:
            self.send_header("Set-Cookie", "session=" + cookie + "; Path=/; HttpOnly")
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, code, html):
        body = html.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _form(self):
        try:
            n = int(self.headers.get("Content-Length", 0))
        except ValueError:
            n = 0
        raw = self.rfile.read(n) if n else b""
        return {k: v[0] for k, v in parse_qs(raw.decode()).items()}

    def _session(self):
        cookie = self.headers.get("Cookie", "")
        sid = ""
        for part in cookie.split(";"):
            part = part.strip()
            if part.startswith("session="):
                sid = part[len("session="):]
                break
        sess = SESSIONS.get(sid)
        return sid, sess["username"] if sess else None, sess

    def _valid_csrf(self, form):
        _, _, sess = self._session()
        if not sess:
            return False
        submitted = form.get("csrf_token", "") or self.headers.get("X-CSRF-Token", "")
        return bool(submitted) and secrets.compare_digest(submitted, sess["csrf"])

    def log_message(self, *args):
        pass

    def do_GET(self):
        parts = urlparse(self.path)
        if parts.path == "/":
            self._send_html(200, PANEL)
            return
        if parts.path == "/me":
            _, username, _ = self._session()
            if not username:
                self._send(401, {"error": "unauthorized"})
                return
            u = USERS[username]
            self._send(200, {"username": username, "email": u["email"],
                             "is_admin": u["is_admin"]})
            return
        if parts.path == "/users":
            _, username, _ = self._session()
            if not username:
                self._send(401, {"error": "unauthorized"})
                return
            if not USERS[username]["is_admin"]:
                self._send(403, {"error": "forbidden"})
                return
            self._send(200, {"users": [
                {"username": n, "is_admin": u["is_admin"]}
                for n, u in USERS.items()]})
            return
        self._send(404, {"error": "not found"})

    def do_POST(self):
        parts = urlparse(self.path)
        if parts.path == "/login":
            form = self._form()
            username = form.get("username", "").strip().lower()
            u = USERS.get(username)
            if not u or u["password"] != form.get("password", ""):
                self._send(401, {"error": "invalid credentials"})
                return
            sid = "sess_" + secrets.token_hex(8)
            csrf = secrets.token_hex(16)
            SESSIONS[sid] = {"username": username, "csrf": csrf}
            self._send(200, {"ok": True, "token": sid, "csrf_token": csrf},
                       cookie=sid)
            return
        if parts.path == "/users":
            _, username, _ = self._session()
            if not username:
                self._send(401, {"error": "unauthorized"})
                return
            if not USERS[username]["is_admin"]:
                self._send(403, {"error": "forbidden"})
                return
            form = self._form()
            if not self._valid_csrf(form):
                self._send(403, {"error": "invalid csrf token"})
                return
            new_user = form.get("username", "").strip().lower()
            password = form.get("password", "")
            if not new_user or not password:
                self._send(400, {"error": "username and password required"})
                return
            if new_user in USERS:
                self._send(409, {"error": "username exists"})
                return
            is_admin = form.get("is_admin", "") in ("1", "true", "True")
            USERS[new_user] = {"password": password,
                               "email": form.get("email", ""),
                               "full_name": form.get("full_name", ""),
                               "is_admin": is_admin}
            self._send(200, {"ok": True, "username": new_user,
                             "is_admin": is_admin})
            return
        self._send(404, {"error": "not found"})


if __name__ == "__main__":
    HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
